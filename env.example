# Copy to .env and adjust. All values shown are the defaults.
LOCAL_ADDRESS=0.0.0.0
PORT=3000

# Embedded SurrealDB (SurrealKV). Use "memory" for a throwaway in-memory database.
DB_PATH=data/db
DB_NAMESPACE=sheets
DB_DATABASE=api
# Applied automatically to a new database only; later changes need a migration.
SCHEMA_PATH=data/schema.surql

# Source files are kept here until every worksheet is imported (or the plan's retention ends).
UPLOAD_DIR=data/uploads
MAX_UPLOAD_SIZE=50MB

PREVIEW_ROWS=30
DEFAULT_PAGE_SIZE=100
MAX_PAGE_SIZE=1000
SWEEP_INTERVAL_SECS=60

RUST_LOG=info,surrealdb=warn

# ---------------------------------------------------------------------------
# Deployment: "demo" (public service with guests + GitHub/Google sign-in) or
# "service" (behind nginx and the primary API). Default: demo.
AUTH_MODE=demo

# --- demo mode -------------------------------------------------------------
# Base URL of this service as browsers reach it (OAuth callbacks are PUBLIC_URL/auth/<provider>/callback)
PUBLIC_URL=http://localhost:3000
# Where to send people after signing in (return_to paths are appended)
FRONTEND_URL=http://localhost:5173
# Required in production: keeps guest identities stable across restarts
GUEST_SALT=change-me-to-a-long-random-string
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GUEST_MAX_UPLOAD_SIZE=2MB
RATE_LIMIT_PER_MINUTE=120
SESSION_DAYS=30
# Only behind a proxy that overwrites it, e.g. nginx: proxy_set_header X-Real-IP $remote_addr;
# CLIENT_IP_HEADER=X-Real-IP
# A frontend on another origin that sends the session cookie
# CORS_ORIGINS=https://sheets.example.com
# Defaults to true when PUBLIC_URL is https
# COOKIE_SECURE=true

# --- service mode ----------------------------------------------------------
# Header the primary API sets to the tenant/user reference (becomes service/<ref>)
# SERVICE_USER_HEADER=X-User-Ref
# Require Authorization: Bearer <token> (or X-Service-Token) on every request
# SERVICE_TOKEN=
# Directory shared with the primary API, for {"path": ...} uploads
# SHARED_UPLOAD_DIR=/srv/shared/spreadsheets
# Hosts {"url": ...} uploads may fetch from (comma-separated); empty = any
# URL_UPLOAD_HOSTS=files.internal
# Identity for requests without the header (local development only)
# DEFAULT_USER_REF=local
